# Matikan eksekusi script PHP dan skrip berbahaya di folder gambar/upload
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Blokir langsung akses file dengan ekstensi skrip yang mencurigakan
<FilesMatch "\.(php|php[0-9]|phtml|phar|inc|pl|cgi|py|sh|bash|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Hanya izinkan file media / gambar
Options -ExecCGI -Indexes
